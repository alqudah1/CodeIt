{
  "name": "e-learning",
  "private": true,
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start:learning": "npm run start --workspace=@e-learning/gamified-elearning",
    "start:backend": "npm run start --workspace=@e-learning/codeit-backend",
    "start:puzzle": "npm run start --workspace=@e-learning/robot-puzzle",
    "start:game": "npm run start --workspace=@e-learning/starter-game",
    "build:learning": "npm run build --workspace=@e-learning/gamified-elearning",
    "test:learning": "npm run test --workspace=@e-learning/gamified-elearning --",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspace=@e-learning/codeit-backend && npm test --workspace=@e-learning/gamified-elearning -- --watchAll=false",
    "test:backend": "npm test --workspace=@e-learning/codeit-backend",
    "db:migrate": "node ops/db/migrate.js",
    "check:browser": "ops/checks/run-all.sh",
    "db:migrate:fresh": "node ops/db/migrate.js --fresh --apply",
    "check:seed": "node ops/checks/seed.js",
    "test:api": "node --test api/*.test.js"
  },
  "version": "1.0.0",
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
