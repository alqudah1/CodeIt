{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:learning",
  "outputDirectory": "packages/gamified-elearning/build",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "packages/codeit-backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    },
    {
      "source": "/(MainPage|admin|ai-website-builder-for-kids|blog|builder|character|coding-for-kids|creator-brief|explore|first-game-challenge|forgot-password|game|games|guide|investor-brief|journey|leaderboard|learn-python-for-kids|lesson|lessons|login|parent-review|playground|pricing|privacy|profile|project|python-games-for-kids|quiz|register|reset-password|terms)(/.*)?",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
