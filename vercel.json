{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:learning",
  "outputDirectory": "packages/gamified-elearning/build",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "packages/codeit-backend/**"
    },
    "api/share.js": {
      "maxDuration": 10,
      "includeFiles": "packages/gamified-elearning/build/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    },
    {
      "source": "/project/:pub*",
      "destination": "/api/share?pub=:pub*"
    },
    {
      "source": "/(MainPage|about|faq|admin|ai-website-builder-for-kids|blog|builder|character|coding-for-kids|creator-brief|explore|first-game-challenge|forgot-password|game|games|guide|investor-brief|journey|leaderboard|learn-python-for-kids|lesson|lessons|login|parent-review|playground|pricing|privacy|profile|python-games-for-kids|quiz|register|reset-password|terms)(/.*)?",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(login|register|forgot-password|reset-password|parent-review|MainPage|admin|character|leaderboard|profile|quiz|project|creator-brief|investor-brief)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?!static/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}