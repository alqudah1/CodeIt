+// being appended to and then walked through — which is lessons 7 and 8.
+
+const MEMORY = `<!doctype html>
+<html>
+<head>
+<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
+<title>Colour Memory</title>
+<style>
+${SHARED_STYLE}
